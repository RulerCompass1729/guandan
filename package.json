{
  "name": "@rulercompass1729/guandan",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "手机亲友牌桌，支持多人联机与电脑补位",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:browser": "playwright test",
    "test:simulation": "node dist/tools/simulate.js",
    "build:android-engine": "node tools/build-native-engine.mjs",
    "test:android": "node tools/native-test.mjs",
    "start": "node dist/src/server.js"
  },
  "dependencies": { "ws": "^8.18.3" },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
